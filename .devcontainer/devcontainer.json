{
  "name": "m3-ui Node 22",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:3-22",
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "forwardPorts": [5173, 6006],
  "portsAttributes": {
    "5173": {
      "label": "Vite playground",
      "onAutoForward": "notify"
    },
    "6006": {
      "label": "Storybook",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "sudo corepack enable && sudo corepack prepare pnpm@10.0.0 --activate && pnpm install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
