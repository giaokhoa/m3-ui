{
  "name": "@m3-ui/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --host 0.0.0.0",
    "build": "storybook build -o dist",
    "preview": "vite preview --host 0.0.0.0 --port 6006 --strictPort",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist test-results playwright-report"
  },
  "dependencies": {
    "@m3-ui/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.9",
    "@storybook/react-vite": "10.5.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "storybook": "10.5.9",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
