{
  "name": "@m3-ui/ui",
  "version": "0.0.0",
  "private": true,
  "description": "React Material 3 component and adaptive layout library built with React Aria Components.",
  "keywords": [
    "material-3",
    "material-design",
    "react",
    "react-aria",
    "ui",
    "design-system"
  ],
  "homepage": "https://github.com/giaokhoa/m3-ui#readme",
  "bugs": {
    "url": "https://github.com/giaokhoa/m3-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giaokhoa/m3-ui.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout.js"
    },
    "./typography": {
      "types": "./dist/theme/typography/typeScale.d.ts",
      "import": "./dist/typography.js"
    },
    "./styles.css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/styles.css"
    },
    "./styles/*.css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/styles/*.css"
    }
  },
  "scripts": {
    "build": "vite build && node scripts/build-styles.mjs && tsc -p tsconfig.build.json && node scripts/sanitize-declarations.mjs",
    "test": "node --test scripts/*.node-tests.mjs && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@m3-ui/tokens": "workspace:*",
    "@material/material-color-utilities": "0.4.0",
    "clsx": "2.1.1",
    "react-aria-components": "^1.21.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
