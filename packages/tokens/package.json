{
  "name": "@m3/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/generated/tokens.js",
  "module": "./dist/generated/tokens.js",
  "types": "./dist/generated/tokens.d.ts",
  "exports": {".": {"types": "./dist/generated/tokens.d.ts", "import": "./dist/generated/tokens.js"}},
  "scripts": {
    "tokens:build": "style-dictionary build --config style-dictionary.config.mjs",
    "build": "rm -rf dist && pnpm tokens:build",
    "test": "rm -rf dist && node scripts/validate.mjs && pnpm tokens:build && node --test scripts/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "inventory:compose": "node scripts/inventory-compose.mjs",
    "inventory:material-web": "node scripts/inventory-material-web.mjs",
    "audit:androidx": "node scripts/audit-androidx.mjs",
    "audit:material-web-declarations": "node scripts/audit-material-web-declarations.mjs",
    "audit:material-web-declarations:complete": "node scripts/audit-material-web-declarations.mjs --require-complete",
    "audit:material-web-button-sizes": "node scripts/audit-material-web-button-sizes.mjs",
    "audit:material-web-button-sizes:complete": "node scripts/audit-material-web-button-sizes.mjs --require-complete",
    "audit:material-web-button-variants": "node scripts/audit-material-web-button-variants.mjs",
    "audit:material-web-button-variants:complete": "node scripts/audit-material-web-button-variants.mjs --require-complete",
    "audit:material-web-button-generic": "node scripts/audit-material-web-button-generic.mjs",
    "audit:material-web-button-generic:complete": "node scripts/audit-material-web-button-generic.mjs --require-complete",
    "audit:material-web-icon-button-sizes": "node scripts/audit-material-web-icon-button-sizes.mjs",
    "audit:material-web-icon-button-sizes:complete": "node scripts/audit-material-web-icon-button-sizes.mjs --require-complete",
    "audit:material-web-icon-button-variants": "node scripts/audit-material-web-icon-button-variants.mjs",
    "audit:material-web-icon-button-variants:complete": "node scripts/audit-material-web-icon-button-variants.mjs --require-complete",
    "clean": "rm -rf dist",
    "coverage:compose": "node scripts/coverage-compose.mjs",
    "coverage:compose:complete": "node scripts/coverage-compose.mjs --require-complete",
    "coverage:material-web": "node scripts/coverage-material-web.mjs",
    "coverage:material-web:complete": "node scripts/coverage-material-web.mjs --require-complete",
    "coverage:union:complete": "node scripts/coverage-union.mjs --require-complete"
  },
  "devDependencies": {"style-dictionary": "5.5.2"}
}
