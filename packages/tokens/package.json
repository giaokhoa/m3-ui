{
  "name": "@m3/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/generated/tokens.js",
  "module": "./dist/generated/tokens.js",
  "types": "./dist/generated/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/generated/tokens.d.ts",
      "import": "./dist/generated/tokens.js"
    },
    "./generated": {
      "types": "./dist/generated/tokens.d.ts",
      "import": "./dist/generated/tokens.js"
    },
    "./button": { "types": "./dist/button.d.ts", "import": "./dist/button.js" },
    "./card": { "types": "./dist/card.d.ts", "import": "./dist/card.js" },
    "./checkbox": { "types": "./dist/checkbox.d.ts", "import": "./dist/checkbox.js" },
    "./chip": { "types": "./dist/chip.d.ts", "import": "./dist/chip.js" },
    "./elevation": { "types": "./dist/elevation.d.ts", "import": "./dist/elevation.js" },
    "./radio-button": { "types": "./dist/radio-button.d.ts", "import": "./dist/radio-button.js" },
    "./text-field": { "types": "./dist/text-field.d.ts", "import": "./dist/text-field.js" }
  },
  "scripts": {
    "tokens:build": "style-dictionary build --config style-dictionary.config.mjs",
    "build": "rm -rf dist && pnpm tokens:build && tsc -p tsconfig.build.json",
    "test": "rm -rf dist && node scripts/validate.mjs && pnpm tokens:build && node --test scripts/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "audit:androidx": "node scripts/audit-androidx.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "style-dictionary": "5.5.2"
  }
}
