{
  "source": ["tokens/**/*.json"],
  "usesDtcg": true,
  "platforms": {
    "css": {
      "transformGroup": "css",
      "buildPath": "dist/generated/",
      "files": [
        {
          "destination": "tokens.css",
          "format": "css/variables"
        }
      ]
    },
    "js": {
      "transformGroup": "js",
      "buildPath": "dist/generated/",
      "files": [
        {
          "destination": "tokens.js",
          "format": "javascript/es6"
        },
        {
          "destination": "tokens.json",
          "format": "json/nested"
        }
      ]
    }
  }
}
