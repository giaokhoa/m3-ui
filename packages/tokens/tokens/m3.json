{
  "$description": "Canonical Material 3 design tokens owned by @m3/tokens. Upstream sources are references for audit only and never generate this file.",
  "$extensions": {
    "m3-ui": {
      "authority": "canonical",
      "policy": "manual-review",
      "references": {
        "androidxRevision": "160825094a81825468a95b115bfb1b541e549856",
        "figmaLibrary": "Material 3 Design Kit",
        "figmaVersion": "1.25"
      }
    }
  },
  "state": {
    "layer": {
      "opacity": {
        "$type": "number",
        "hover": { "$value": 0.08 },
        "focus": { "$value": 0.1 },
        "pressed": { "$value": 0.1 },
        "dragged": { "$value": 0.16 }
      }
    }
  },
  "elevation": {
    "$type": "dimension",
    "level0": { "$value": { "value": 0, "unit": "px" } },
    "level1": { "$value": { "value": 1, "unit": "px" } },
    "level2": { "$value": { "value": 3, "unit": "px" } },
    "level3": { "$value": { "value": 6, "unit": "px" } },
    "level4": { "$value": { "value": 8, "unit": "px" } },
    "level5": { "$value": { "value": 12, "unit": "px" } }
  },
  "typography": {
    "labelLarge": {
      "fontFamily": { "$type": "string", "$value": "plain" },
      "fontSize": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
      "lineHeight": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
      "fontWeight": { "$type": "number", "$value": 500 },
      "letterSpacing": { "$type": "dimension", "$value": { "value": 0.1, "unit": "px" } }
    },
    "titleMedium": {
      "fontFamily": { "$type": "string", "$value": "plain" },
      "fontSize": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "lineHeight": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
      "fontWeight": { "$type": "number", "$value": 500 },
      "letterSpacing": { "$type": "dimension", "$value": { "value": 0.2, "unit": "px" } }
    },
    "headlineSmall": {
      "fontFamily": { "$type": "string", "$value": "brand" },
      "fontSize": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
      "lineHeight": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
      "fontWeight": { "$type": "number", "$value": 400 },
      "letterSpacing": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
    },
    "headlineLarge": {
      "fontFamily": { "$type": "string", "$value": "brand" },
      "fontSize": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
      "lineHeight": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
      "fontWeight": { "$type": "number", "$value": 400 },
      "letterSpacing": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
    }
  },
  "component": {
    "button": {
      "baseline": {
        "minWidth": { "$type": "dimension", "$value": { "value": 58, "unit": "px" } },
        "minHeight": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
        "containerShape": { "$type": "string", "$value": "full" },
        "disabledContainerOpacity": { "$type": "number", "$value": 0.1 },
        "disabledContentOpacity": { "$type": "number", "$value": 0.38 },
        "iconSize": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
        "iconSpacing": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "padding": {
          "block": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
          "inlineStart": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
          "inlineEnd": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
        },
        "iconPadding": {
          "block": { "$type": "dimension", "$value": "{component.button.baseline.padding.block}" },
          "inlineStart": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
          "inlineEnd": { "$type": "dimension", "$value": "{component.button.baseline.padding.inlineEnd}" }
        }
      },
      "size": {
        "extraSmall": {
          "height": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
          "paddingInline": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
          "iconSize": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
          "iconSpacing": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
          "typography": { "$type": "string", "$value": "labelLarge" },
          "pressedShape": { "$type": "string", "$value": "small" }
        },
        "small": {
          "height": { "$type": "dimension", "$value": "{component.button.baseline.minHeight}" },
          "paddingInline": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
          "iconSize": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
          "iconSpacing": { "$type": "dimension", "$value": "{component.button.baseline.iconSpacing}" },
          "typography": { "$type": "string", "$value": "labelLarge" },
          "pressedShape": { "$type": "string", "$value": "small" }
        },
        "medium": {
          "height": { "$type": "dimension", "$value": { "value": 56, "unit": "px" } },
          "paddingInline": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
          "iconSize": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
          "iconSpacing": { "$type": "dimension", "$value": "{component.button.baseline.iconSpacing}" },
          "typography": { "$type": "string", "$value": "titleMedium" },
          "pressedShape": { "$type": "string", "$value": "medium" }
        },
        "large": {
          "height": { "$type": "dimension", "$value": { "value": 96, "unit": "px" } },
          "paddingInline": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
          "iconSize": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
          "iconSpacing": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
          "typography": { "$type": "string", "$value": "headlineSmall" },
          "pressedShape": { "$type": "string", "$value": "large" }
        },
        "extraLarge": {
          "height": { "$type": "dimension", "$value": { "value": 136, "unit": "px" } },
          "paddingInline": { "$type": "dimension", "$value": { "value": 64, "unit": "px" } },
          "iconSize": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
          "iconSpacing": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
          "typography": { "$type": "string", "$value": "headlineLarge" },
          "pressedShape": { "$type": "string", "$value": "large" }
        }
      }
    },
    "switch": {
      "track": {
        "width": { "$type": "dimension", "$value": { "value": 52, "unit": "px" } },
        "height": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
        "outlineWidth": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } }
      },
      "handle": {
        "unselectedSize": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "selectedSize": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
        "pressedSize": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } },
        "iconSize": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
      },
      "stateLayerSize": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
      "minimumInteractiveSize": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } }
    }
  }
}
