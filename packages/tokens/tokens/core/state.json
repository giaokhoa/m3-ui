{
  "state": {
    "layer": {
      "opacity": {
        "$type": "number",
        "hover": { "$value": 0.08 },
        "focus": { "$value": 0.1 },
        "pressed": { "$value": 0.1 },
        "dragged": { "$value": 0.16 }
      }
    },
    "disabled": {
      "contentOpacity": { "$type": "number", "$value": 0.38 }
    },
    "focusIndicator": {
      "innerOffset": { "$type": "dimension", "$value": { "value": -3, "unit": "px" } },
      "outerOffset": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
      "thickness": { "$type": "dimension", "$value": { "value": 3, "unit": "px" } }
    }
  }
}
