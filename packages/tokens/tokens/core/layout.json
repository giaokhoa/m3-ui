        "expandedLowerBound": { "$type": "dimension", "$value": { "value": 840, "unit": "px" } },
        "largeLowerBound": { "$type": "dimension", "$value": { "value": 1200, "unit": "px" } },
        "extraLargeLowerBound": { "$type": "dimension", "$value": { "value": 1600, "unit": "px" } }
      },
      "height": {
        "mediumLowerBound": { "$type": "dimension", "$value": { "value": 480, "unit": "px" } },
        "expandedLowerBound": { "$type": "dimension", "$value": { "value": 900, "unit": "px" } }
