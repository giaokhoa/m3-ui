{
  "component": {
    "menuButton": {
      "shared": {
        "containerHeight": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
        "trailingIconSize": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
        "leadingIconSize": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
        "labelTextFont": { "$type": "string", "$value": "labelLarge" },
        "focusIndicatorColor": { "$type": "string", "$value": "var(--secondary)" }
      },
      "filled": {
        "containerColor": { "$type": "string", "$value": "var(--primary)" },
        "containerElevation": { "$type": "string", "$value": "level0" },
        "disabledContainerColor": { "$type": "string", "$value": "var(--on-surface)" },
