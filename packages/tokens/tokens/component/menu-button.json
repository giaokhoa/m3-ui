        "disabledContainerOpacity": { "$type": "number", "$value": 0.12 },
        "disabledLabelTextOpacity": { "$type": "number", "$value": 0.38 }
      },
      "standard": {
        "containerShape": { "$type": "string", "$value": "full" },
        "labelTextColor": { "$type": "string", "$value": "var(--on-surface-variant)" },
        "trailingIconColor": { "$type": "string", "$value": "var(--on-surface-variant)" },
        "disabledLabelTextOpacity": { "$type": "number", "$value": 0.38 }
      }
    }
  }
}
