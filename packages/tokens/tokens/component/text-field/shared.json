{
  "component": {
    "textField": {
      "shared": {
        "minWidth": { "$type": "dimension", "$value": { "value": 280, "unit": "px" } },
        "minHeight": { "$type": "dimension", "$value": { "value": 56, "unit": "px" } },
        "lineHeight": {
          "inputMin": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
          "focusedLabelMin": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
          "supportingMin": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
        },
        "iconSize": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
        "iconSlotSize": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
        "disabledOpacity": { "$type": "number", "$value": 0.38 },
        "colors": {
          "text": { "$type": "string", "$value": "{color.role.onSurface}" },
          "disabledText": { "$type": "string", "$value": "{color.role.onSurface}" },
          "cursor": { "$type": "string", "$value": "{color.role.primary}" },
          "errorCursor": { "$type": "string", "$value": "{color.role.error}" },
          "label": { "$type": "string", "$value": "{color.role.onSurfaceVariant}" },
          "focusedLabel": { "$type": "string", "$value": "{color.role.primary}" },
          "disabledLabel": { "$type": "string", "$value": "{color.role.onSurface}" },
          "errorLabel": { "$type": "string", "$value": "{color.role.error}" },
          "placeholder": { "$type": "string", "$value": "{color.role.onSurfaceVariant}" },
          "disabledPlaceholder": { "$type": "string", "$value": "{color.role.onSurface}" },
          "supporting": { "$type": "string", "$value": "{color.role.onSurfaceVariant}" },
          "disabledSupporting": { "$type": "string", "$value": "{color.role.onSurface}" },
          "errorSupporting": { "$type": "string", "$value": "{color.role.error}" },
          "leadingIcon": { "$type": "string", "$value": "{color.role.onSurfaceVariant}" },
          "trailingIcon": { "$type": "string", "$value": "{color.role.onSurfaceVariant}" },
          "disabledLeadingIcon": { "$type": "string", "$value": "{color.role.onSurface}" },
          "disabledTrailingIcon": { "$type": "string", "$value": "{color.role.onSurface}" },
          "errorLeadingIcon": { "$type": "string", "$value": "{color.role.onSurfaceVariant}" },
          "errorTrailingIcon": { "$type": "string", "$value": "{color.role.error}" },
          "prefix": { "$type": "string", "$value": "{color.role.onSurfaceVariant}" },
          "suffix": { "$type": "string", "$value": "{color.role.onSurfaceVariant}" }
        },
        "typography": {
          "bodyLarge": {
            "fontFamily": { "$type": "string", "$value": "{typography.bodyLarge.fontFamily}" },
            "fontSize": { "$type": "dimension", "$value": "{typography.bodyLarge.fontSize}" },
            "lineHeight": { "$type": "dimension", "$value": "{typography.bodyLarge.lineHeight}" },
            "fontWeight": { "$type": "number", "$value": "{typography.bodyLarge.fontWeight}" },
            "letterSpacing": { "$type": "dimension", "$value": "{typography.bodyLarge.letterSpacing}" }
          },
          "bodySmall": {
            "fontFamily": { "$type": "string", "$value": "{typography.bodySmall.fontFamily}" },
            "fontSize": { "$type": "dimension", "$value": "{typography.bodySmall.fontSize}" },
            "lineHeight": { "$type": "dimension", "$value": "{typography.bodySmall.lineHeight}" },
            "fontWeight": { "$type": "number", "$value": "{typography.bodySmall.fontWeight}" },
            "letterSpacing": { "$type": "dimension", "$value": "{typography.bodySmall.letterSpacing}" }
          }
        },
        "motion": {
          "fastEffects": {
            "duration": { "$type": "string", "$value": "{motion.spring.fastEffects.duration}" },
            "easing": { "$type": "string", "$value": "{motion.spring.fastEffects.easing}" }
          },
          "fastSpatial": {
            "duration": { "$type": "string", "$value": "{motion.spring.fastSpatial.duration}" },
            "easing": { "$type": "string", "$value": "{motion.spring.fastSpatial.easing}" }
          }
        }
      }
    }
  }
}
