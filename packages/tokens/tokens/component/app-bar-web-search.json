      "variant": {
        "small": {
          "searchContainerHeight": { "$type": "dimension", "$value": { "value": 56, "unit": "px" } },
          "searchContainerShape": { "$type": "string", "$value": "full" },
          "searchLabelTextTypography": { "$type": "string", "$value": "bodyLarge" }
        }
      }
    }
  }
