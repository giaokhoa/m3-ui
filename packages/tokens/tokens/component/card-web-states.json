{
  "component": {
    "card": {
      "base": {
        "iconSize": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
        "iconColor": { "$type": "string", "$value": "var(--primary)" },
        "containerShape": { "$type": "string", "$value": "medium" },
        "containerShadowColor": { "$type": "string", "$value": "var(--shadow)" },
        "focusIndicatorColor": { "$type": "string", "$value": "var(--secondary)" },
        "focusIndicatorOutlineOffset": { "$type": "dimension", "$value": "{state.focusIndicator.outerOffset}" },
        "focusIndicatorThickness": { "$type": "dimension", "$value": "{state.focusIndicator.thickness}" },
        "state": {
          "dragged": {
            "color": { "$type": "string", "$value": "var(--on-surface)" },
            "opacity": { "$type": "number", "$value": "{state.layer.opacity.dragged}" }
          },
          "focus": {
            "color": { "$type": "string", "$value": "var(--on-surface)" },
            "opacity": { "$type": "number", "$value": "{state.layer.opacity.focus}" }
          },
          "hover": {
            "color": { "$type": "string", "$value": "var(--on-surface)" },
            "opacity": { "$type": "number", "$value": "{state.layer.opacity.hover}" }
          },
          "pressed": {
            "color": { "$type": "string", "$value": "var(--on-surface)" },
            "opacity": { "$type": "number", "$value": "{state.layer.opacity.pressed}" }
          }
        }
      },
      "variant": {
        "outlined": {
          "outline": {
            "draggedColor": { "$type": "string", "$value": "var(--outline-variant)" },
            "focusColor": { "$type": "string", "$value": "var(--on-surface)" },
            "hoverColor": { "$type": "string", "$value": "var(--outline-variant)" },
            "pressedColor": { "$type": "string", "$value": "var(--outline-variant)" }
          }
        }
      }
    }
  }
}
