{
  "component": {
    "checkbox": {
      "iconSize": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
      "outline": {
        "selectedWidth": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "focusIndicatorColor": { "$type": "string", "$value": "var(--secondary)" },
      "focusIndicatorOutlineOffset": { "$type": "dimension", "$value": "{state.focusIndicator.outerOffset}" },
      "focusIndicatorThickness": { "$type": "dimension", "$value": "{state.focusIndicator.thickness}" },
      "stateLayerShape": { "$type": "dimension", "$value": "{shape.full}" },
      "selectedPressedStateLayerColor": { "$type": "string", "$value": "var(--on-surface)" },
      "unselectedInteractiveOutlineColor": { "$type": "string", "$value": "var(--on-surface)" },
      "unselectedPressedStateLayerColor": { "$type": "string", "$value": "var(--primary)" },
      "error": {
        "selectedContainerColor": { "$type": "string", "$value": "var(--error)" },
        "selectedIconColor": { "$type": "string", "$value": "var(--on-error)" },
        "unselectedOutlineColor": { "$type": "string", "$value": "var(--error)" },
        "stateLayerColor": { "$type": "string", "$value": "var(--error)" }
      }
    }
  }
}
