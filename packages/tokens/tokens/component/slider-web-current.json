{
  "component": {
    "slider": {
      "webCurrent": {
        "activeStopIndicatorContainerOpacity": { "$type": "number", "$value": 1 },
        "activeStopIndicatorContainerColor": { "$type": "string", "$value": "var(--on-primary)" },
        "inactiveStopIndicatorContainerOpacity": { "$type": "number", "$value": 1 },
        "inactiveStopIndicatorContainerColor": { "$type": "string", "$value": "var(--on-secondary-container)" },
        "disabledActiveStopIndicatorContainerColor": { "$type": "string", "$value": "var(--inverse-on-surface)" },
        "disabledInactiveStopIndicatorContainerColor": { "$type": "string", "$value": "var(--on-surface)" },
        "activeTrackInnerCornerCornerSize": { "$type": "string", "$value": "0 2px 2px 0" },
        "activeTrackOuterCornerCornerSize": { "$type": "string", "$value": "full" },
        "stopIndicatorColor": { "$type": "string", "$value": "var(--on-secondary-container)" },
        "stopIndicatorColorSelected": { "$type": "string", "$value": "var(--on-primary)" },
        "stopIndicatorTrailingSpace": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
        "valueIndicatorLabelTextTracking": { "$type": "dimension", "$value": "{typography.bodyLarge.letterSpacing}" },
        "valueIndicatorLabelTextWeight": { "$type": "number", "$value": "{typography.bodyLarge.fontWeight}" }
      }
    }
  }
}
