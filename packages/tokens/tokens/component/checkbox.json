{
  "component": {
    "checkbox": {
      "containerSize": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
      "containerRadius": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
      "stateLayerSize": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
      "minimumInteractiveSize": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
      "strokeWidth": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
      "colors": {
        "selectedContainer": { "$type": "string", "$value": "var(--primary)" },
        "selectedIcon": { "$type": "string", "$value": "var(--on-primary)" },
        "unselectedOutline": { "$type": "string", "$value": "var(--on-surface-variant)" },
        "disabledSelectedContainer": { "$type": "string", "$value": "var(--on-surface)" },
        "disabledSelectedIcon": { "$type": "string", "$value": "var(--surface)" },
        "disabledUnselectedOutline": { "$type": "string", "$value": "var(--on-surface)" }
      },
      "disabledOpacity": {
        "selectedContainer": { "$type": "number", "$value": 0.38 },
        "unselectedOutline": { "$type": "number", "$value": 0.38 }
      },
      "mark": {
        "checkPath": {
          "leftX": { "$type": "number", "$value": 0.25 },
          "leftY": { "$type": "number", "$value": 0.5 },
          "crossX": { "$type": "number", "$value": 0.4 },
          "crossY": { "$type": "number", "$value": 0.65 },
          "rightX": { "$type": "number", "$value": 0.75 },
          "rightY": { "$type": "number", "$value": 0.3 }
        }
      },
      "motion": {
        "boxIn": {
          "duration": { "$type": "string", "$value": "{motion.spring.defaultEffects.duration}" },
          "easing": { "$type": "string", "$value": "{motion.spring.defaultEffects.easing}" }
        },
        "boxOut": {
          "duration": { "$type": "string", "$value": "{motion.spring.fastEffects.duration}" },
          "easing": { "$type": "string", "$value": "{motion.spring.fastEffects.easing}" }
        },
        "mark": {
          "duration": { "$type": "string", "$value": "{motion.spring.defaultSpatial.duration}" },
          "easing": { "$type": "string", "$value": "{motion.spring.defaultSpatial.easing}" },
          "outDelay": { "$type": "string", "$value": "100ms" }
        }
      }
    }
  }
}
