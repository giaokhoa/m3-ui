{
  "component": {
    "button": {
      "baseline": {
        "minWidth": { "$type": "dimension", "$value": { "value": 58, "unit": "px" } },
        "minHeight": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
        "containerShape": { "$type": "string", "$value": "full" },
        "disabledContainerOpacity": { "$type": "number", "$value": 0.1 },
        "disabledContentOpacity": { "$type": "number", "$value": 0.38 },
        "outlineColor": { "$type": "string", "$value": "transparent" },
        "outlineWidth": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "disabledOutlineOpacity": { "$type": "number", "$value": 0 },
        "iconSize": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
        "iconSpacing": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "labelTypography": { "$type": "string", "$value": "labelLarge" },
        "padding": {
          "block": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
          "inlineStart": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
          "inlineEnd": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
        },
        "iconPadding": {
          "block": { "$type": "dimension", "$value": "{component.button.baseline.padding.block}" },
          "inlineStart": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
          "inlineEnd": { "$type": "dimension", "$value": "{component.button.baseline.padding.inlineEnd}" }
        }
      }
    }
  }
}
