{
  "name": "m3-ui-workspace",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "storybook": "pnpm --filter @m3/storybook dev",
    "build:storybook": "pnpm --filter @m3/storybook build",
    "test": "turbo test",
